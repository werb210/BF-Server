{
  "name": "bf-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --trace-deprecation dist/index.js",
    "dev": "ts-node src/index.ts",
    "postinstall": "npm run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:ci": "vitest run",
    "test:integration": "VITEST_INTEGRATION=true vitest run",
    "postbuild": "node scripts/write-build-info.mjs",
    "triage": "node scripts/triage.mjs"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "@azure-rest/ai-document-intelligence": "^1.0.0",
    "@azure/storage-blob": "^12.31.0",
    "@simplewebauthn/server": "^13.3.1",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "execa": "^9.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.3.2",
    "file-type": "^21.3.4",
    "googleapis": "^185.0.0",
    "helmet": "^8.1.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "openai": "^6.49.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "twilio": "^4.23.0",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.15",
    "@types/archiver": "^6.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.4",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.12"
  },
  "optionalDependencies": {
    "rollup": "^4.0.0"
  },
  "type": "module",
  "overrides": {
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8"
  }
}
